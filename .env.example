# Local development configuration
# For cloud deployment, GCP variables are set via Terraform (`deployment/terraform/`) or `agents-cli deploy`.

# Active model profile (`remote` for Gemini, `local` for Ollama via LiteLLM)
MODEL_PROFILE=remote

# --- Remote Model (Option A: Google AI Studio / Free Tier — easiest for local benchmarks) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Pause between remote requests (seconds) to stay within Google AI Studio Free Tier RPM limits.
# Set to 0.0 on paid tier / Vertex AI.
REMOTE_REQUEST_DELAY_S=6.0

# --- Remote Model (Option B: Vertex AI / Gemini Platform on GCP) ---
# Uncomment the three lines below (and comment out GEMINI_API_KEY) when using GCP ADC:
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Local Model (Ollama via LiteLLM `ollama_chat/<model>`) ---
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- Shared Generation & Evaluation Controls ---
MODEL_TEMPERATURE=0.2
EVAL_JUDGE_MODEL=gemini-3.8-flash
