# Local-first development configuration
# Runs 100% locally for both Local Ollama and Remote Gemini API (`GEMINI_API_KEY`) profiles.
# Optional cloud deployment variables are managed via Terraform (`deployment/terraform/`) or `agents-cli deploy`.

# Active model profile (`remote` for Gemini, `local` for Ollama via LiteLLM)
MODEL_PROFILE=remote

# --- Remote Model (Option A: Google AI Studio / Free Tier — easiest for local benchmarks) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Pause between remote requests (seconds) to stay within Google AI Studio Free Tier RPM limits.
# Set to 0.0 on paid tier / Vertex AI.
REMOTE_REQUEST_DELAY_S=6.0

# --- Remote Model (Option B: Optional Vertex AI / Gemini Platform on GCP) ---
# Uncomment the three lines below (and comment out GEMINI_API_KEY) when using GCP ADC:
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# --- Local Model (Ollama via LiteLLM `ollama_chat/<model>`) ---
OLLAMA_API_BASE=http://localhost:11434
# Verified tool-calling Ollama models: `qwen2.5:3b` (default), `qwen2.5:1.5b`, `qwen3:8b`, `llama3.2:3b`.
# Do NOT use `gemma3:4b`: it lacks native Ollama tool calling and fails with HTTP 400 on ADK tool nodes.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window passed to Ollama (`options.num_ctx`). Keep >= 8192 to avoid
# truncating system instructions and compacted RAG tool outputs in multi-node workflows.
OLLAMA_NUM_CTX=8192
# Optional reasoning toggle (`think`) for Ollama thinking models (e.g., `qwen3:8b`).
# Leave unset for model default, or set to `false` for lower-latency runs.
# OLLAMA_THINK=false

# --- Offline Hybrid RAG (shared identically by local and remote profiles) ---
RAG_INDEX_PATH=app/data/rag_index.sqlite3
RAG_ENABLE_DENSE=true
# Optional dense retrieval tuning (defaults match `app/tools/rag.py`):
# RAG_EMBED_TIMEOUT_S=2.0
# RAG_MIN_DENSE_SIMILARITY=0.55

# --- Shared Generation & Evaluation Controls ---
MODEL_TEMPERATURE=0.2
EVAL_JUDGE_MODEL=gemini-3.8-flash
